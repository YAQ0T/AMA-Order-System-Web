# Copy to `.env.local` only if you need it. In most setups you do NOT.
#
# Leave VITE_API_URL unset when:
#   - developing (vite.config.js proxies /api to http://localhost:6001)
#   - deploying behind the Node server (it serves client/dist itself)
# In both cases the browser talks to a single origin: no CORS, nothing to configure.
#
# Set it only when the API lives somewhere else, e.g. a separate host:
# VITE_API_URL=http://192.168.1.50:6001
#
# A localhost value here is ignored on purpose - see src/api/client.js.
VITE_API_URL=
