# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Server ----
# Port the API listens on.
PORT=6001

# Secret used to sign JWTs. Change this - the fallback in middleware/auth.js
# is the literal string 'your-secret-key', which is not safe for anything real.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database (MySQL / MariaDB) ----
DB_NAME=ama_order_system
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# IMPORTANT - create the database with utf8mb4, or Arabic will be stored as "????":
#
#   CREATE DATABASE ama_order_system
#     CHARACTER SET utf8mb4
#     COLLATE utf8mb4_unicode_ci;
#
# MySQL's legacy "utf8" is a 3-byte subset that cannot hold the full Unicode
# range, and some installers still default a new database to latin1. The app
# sets utf8mb4 on the tables it creates, but the database itself must match.
#
# utf8mb4_unicode_ci is also case-insensitive, which is what makes order search
# work (it uses LIKE). A binary collation such as utf8mb4_bin would silently
# make search case-sensitive.
#
# The server creates its tables on first start; you only create the database.

# Set to true for ONE run when migrating an older schema, then set it back.
# This runs Sequelize's `alter: true`, which re-adds indexes it believes are
# missing. MySQL caps a table at 64 keys, so leaving this on can accumulate
# duplicate indexes across restarts until ALTER TABLE fails. Leave it unset on
# a fresh database - it is not needed.
DB_ALTER=

# ---- Telegram notifications (takers and accountants) ----
# Create a bot with @BotFather in Telegram (/newbot) and paste its token here.
# This is the ONLY way the system reaches a phone - it sends no email. Takers
# (new orders, edits) and accountants (orders ready for ERP) link their account
# from the app; anyone not linked only sees it when they open the app. Makers
# and admins cannot link. Leave blank to disable.
# Works without HTTPS or a public address: the server polls Telegram.
# Only ONE running server may use a given bot token at a time.
TELEGRAM_BOT_TOKEN=

# Optional. The address takers use to open the system, e.g.
# http://192.168.1.33:6001 - adds an "open the system" button to each message.
APP_URL=

# ---- Web push notifications ----
# Generate a fresh pair with:  npx web-push generate-vapid-keys
# Leave blank to disable push (the app still works; in-app notifications poll).
# Push also requires HTTPS or localhost - it will not work over a plain
# http://192.168.x.x LAN address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
